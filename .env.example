# Postgres (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://shakti:shakti@localhost:5432/shakti_caterers?schema=public"

# Used to sign customer and admin session JWTs. Replace with a long random string.
SESSION_SECRET="replace-with-a-long-random-string"

# Razorpay TEST mode keys — get these from your Razorpay dashboard (Test Mode).
# Placeholders below will NOT work for real payments.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"

# Seeded admin login (prisma/seed.ts)
ADMIN_EMAIL="admin@shakticaterers.example"
ADMIN_PASSWORD="ChangeMe@12345"

# When true, OTP codes are returned in the API response and shown on-screen
# at /account/login for local/demo use (no real SMS is sent). Set to "false"
# once a real SMS provider is wired into lib/otp/sendOtp.ts.
DEV_EXPOSE_OTP="true"

APP_BASE_URL="http://localhost:3000"
